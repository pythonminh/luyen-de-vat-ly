\section*{PHẦN II. TRẮC NGHIỆM ĐÚNG / SAI}
\textit{Thí sinh trả lời từ câu 1 đến câu 4. Trong mỗi ý a), b), c), d), chọn đúng hoặc sai.}

\begin{ex}
Xét khối khí như trong hình. Dùng tay ấn mạnh và nhanh pit-tông, vừa nung nóng khí bằng ngọn lửa đèn cồn.

\begin{center}
\begin{tikzpicture}[>=Latex,scale=.75]
    \draw[thick] (-2,0) rectangle (1.2,1.2);
    \draw[thick] (1.2,.1) rectangle (1.55,1.1);
    \draw[->,very thick] (2.5,.6)--(1.55,.6) node[midway,above] {Nén};
    \draw[thick] (-.2,-1.1)--(.2,-.1);
    \draw[thick] (-.2,-1.1)--(.2,-1.1);
    \draw[thick] (-.05,-.55) .. controls (-.35,-.35) and (.35,-.35) .. (-.05,-.05);
    \node at (-.35,-1.35) {Đèn cồn};
\end{tikzpicture}
\end{center}

\choiceTF
{\True Công $A>0$ vì khí bị nén (khí nhận công).}
{Nhiệt lượng $Q<0$ vì khí bị nung nóng (khí nhận nhiệt).}
{\True Nội năng của khí tăng $\Delta U>0$.}
{Biểu thức liên hệ độ biến thiên nội năng, công và nhiệt lượng là $\Delta U=A-Q$.}
\loigiai{
a) Đúng, vì khí bị nén nên khí nhận công: $A>0$.

b) Sai, vì khí được nung nóng nên khí nhận nhiệt: $Q>0$.

c) Đúng, vì cả $A>0$ và $Q>0$ nên
\[
\Delta U=A+Q>0.
\]

d) Sai. Hệ thức đúng là
\[
\Delta U=A+Q.
\]
}
\end{ex}

\begin{ex}
Trong quá trình đang nóng chảy của vật rắn:
\choiceTF
{Nhiệt được truyền vào vật rắn để làm tăng nhiệt độ của nó.}
{Động năng trung bình của các phân tử trong vật rắn tăng lên.}
{\True Nội năng của vật rắn thay đổi.}
{Tại nhiệt độ nóng chảy, nội năng không thay đổi.}
\loigiai{
a) Sai. Trong quá trình nóng chảy của chất rắn kết tinh, nhiệt độ không đổi.

b) Sai. Vì nhiệt độ không đổi nên động năng trung bình của các phân tử không tăng.

c) Đúng. Vật vẫn nhận nhiệt lượng nên nội năng thay đổi.

d) Sai. Nội năng vẫn tăng trong quá trình nóng chảy do thế năng tương tác giữa các phân tử thay đổi.
}
\end{ex}

\begin{ex}
Xét một khối khí trong bình kín bị nung nóng.
\choiceTF
{Khí truyền nhiệt ($Q$) ra môi trường xung quanh.}
{Công ($A$) khác $0$ vì thể tích khí thay đổi.}
{\True Nội năng ($U$) của khí tăng.}
{\True Hệ thức phù hợp với quá trình $\Delta U=Q,\ Q>0$.}
\loigiai{
a) Sai. Khí được nung nóng nên khí nhận nhiệt, $Q>0$.

b) Sai. Bình kín và thể tích không đổi nên khí không thực hiện công, $A=0$.

c) Đúng. Vì $Q>0$ và $A=0$ nên $\Delta U=Q>0$.

d) Đúng. Hệ thức phù hợp là
\[
\Delta U=A+Q=Q,\qquad Q>0.
\]
}
\end{ex}

\begin{ex}
Một lượng nước và một lượng rượu có thể tích bằng nhau được cung cấp các nhiệt lượng tương ứng là $Q_1$ và $Q_2$. Biết khối lượng riêng của nước là $1000\,\mathrm{kg/m^3}$ và của rượu là $800\,\mathrm{kg/m^3}$, nhiệt dung riêng của nước là $4200\,\mathrm{J/(kg.K)}$ và của rượu là $2500\,\mathrm{J/(kg.K)}$.
\choiceTF
{Nhiệt lượng để làm tăng nhiệt độ của $1\,\mathrm{kg}$ nước lên $1\,\mathrm{K}$ là $2500\,\mathrm{J/(kg.K)}$.}
{Nhiệt lượng để làm tăng nhiệt độ của $1\,\mathrm{kg}$ rượu lên $1\,\mathrm{K}$ là $4200\,\mathrm{J/(kg.K)}$.}
{\True Có thể dùng công thức $Q=mc(T_2-T_1)$ để tính nhiệt lượng cung cấp cho nước và rượu.}
{\True Để độ tăng nhiệt độ của nước và rượu bằng nhau thì $Q_1=2{,}1Q_2$.}
\loigiai{
a) Sai. Nhiệt dung riêng của nước là $4200\,\mathrm{J/(kg.K)}$.

b) Sai. Nhiệt dung riêng của rượu là $2500\,\mathrm{J/(kg.K)}$.

c) Đúng. Ta dùng
\[
Q=mc(T_2-T_1).
\]

d) Đúng. Hai lượng có cùng thể tích nên
\[
\frac{m_{\text{nước}}}{m_{\text{rượu}}}
=\frac{\rho_{\text{nước}}}{\rho_{\text{rượu}}}
=\frac{1000}{800}=1{,}25.
\]
Với cùng độ tăng nhiệt độ:
\[
\frac{Q_1}{Q_2}
=\frac{m_1c_1}{m_2c_2}
=1{,}25\cdot\frac{4200}{2500}
=2{,}1.
\]
Suy ra $Q_1=2{,}1Q_2$.
}
\end{ex}


