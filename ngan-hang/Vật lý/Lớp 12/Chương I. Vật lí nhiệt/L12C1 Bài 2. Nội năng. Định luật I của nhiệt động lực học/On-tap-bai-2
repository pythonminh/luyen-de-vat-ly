{Hai khối đều cần nhiệt lượng như nhau.}
{Không khẳng định được.}
\loigiai{Theo $Q=mc\Delta t$, hai vật có cùng $m$ và $\Delta t$. Vì $c_{\text{đồng}}>c_{\text{chì}}$ nên $Q_{\text{đồng}}>Q_{\text{chì}}$.}
\end{ex}

\begin{ex}
