\choice
{$Q=m(t-t_0)$.}
{$Q=mC(t_0-t)$.}
{\True $Q=mc(t-t_0)$.}
{$Q=mc$.}
\loigiai{Khi vật thu nhiệt và nhiệt độ tăng, $\Delta t=t-t_0$, do đó $Q=mc(t-t_0)$.}
\end{ex}

\begin{ex}
