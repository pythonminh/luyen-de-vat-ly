\section*{PHẦN III. TRẮC NGHIỆM TRẢ LỜI NGẮN}
\textit{Thí sinh trả lời từ câu 1 đến câu 6.}

\begin{ex}
Một lượng khí nhận nhiệt lượng $250\,\mathrm{kJ}$ do được đun nóng; đồng thời nhận công $500\,\mathrm{kJ}$ do bị nén. Độ tăng nội năng của lượng khí là bao nhiêu kJ?
\shortans{750}
\loigiai{
Khí nhận nhiệt:
\[
Q=250\,\mathrm{kJ}.
\]
Khí nhận công:
\[
A=500\,\mathrm{kJ}.
\]
Theo nguyên lí I nhiệt động lực học:
\[
\Delta U=A+Q=500+250=750\,\mathrm{kJ}.
\]
}
\end{ex}

\begin{ex}
Người ta thực hiện công $200\,\mathrm{J}$ để nén khí trong một xilanh. Biết khí truyền ra môi trường xung quanh nhiệt lượng $40\,\mathrm{J}$. Độ biến thiên nội năng của khí là bao nhiêu Jun?
\shortans{160}
\loigiai{
Khí bị nén nên nhận công:
\[
A=200\,\mathrm{J}.
\]
Khí truyền nhiệt ra môi trường:
\[
Q=-40\,\mathrm{J}.
\]
Do đó
\[
\Delta U=A+Q=200-40=160\,\mathrm{J}.
\]
}
\end{ex}

\begin{ex}
Một quả bóng khối lượng $200\,\mathrm{g}$ rơi từ độ cao $15\,\mathrm{m}$ xuống sân và nảy lên được $10\,\mathrm{m}$. Độ biến thiên nội năng của quả bóng bằng bao nhiêu Jun? Lấy $g=10\,\mathrm{m/s^2}$.
\shortans{10}
\loigiai{
Phần cơ năng bị hao hụt chuyển thành nội năng của bóng:
\[
\Delta U=mg(h_1-h_2).
\]
Với $m=0{,}2\,\mathrm{kg}$:
\[
\Delta U=0{,}2\cdot10\cdot(15-10)=10\,\mathrm{J}.
\]
}
\end{ex}

\begin{ex}
Một viên đạn đại bác có khối lượng $10\,\mathrm{kg}$ khi rơi tới đích có vận tốc $54\,\mathrm{km/h}$. Nếu toàn bộ động năng của nó biến thành nội năng thì nhiệt lượng tỏa ra lúc va chạm vào khoảng bao nhiêu Jun?
\shortans{1125}
\loigiai{
Đổi:
\[
v=54\,\mathrm{km/h}=15\,\mathrm{m/s}.
\]
Động năng của viên đạn:
\[
W_{\mathrm{đ}}=\frac12mv^2
=\frac12\cdot10\cdot15^2
=1125\,\mathrm{J}.
\]
Toàn bộ động năng biến thành nội năng nên nhiệt lượng tỏa ra có độ lớn:
\[
Q=1125\,\mathrm{J}.
\]
}
\end{ex}

\begin{ex}
Để xác định nhiệt độ của một lò nung, người ta đưa vào trong lò một miếng sắt có khối lượng $50\,\mathrm{g}$. Khi miếng sắt có nhiệt độ bằng nhiệt độ của lò, người ta lấy ra và thả nó vào một nhiệt lượng kế chứa $900\,\mathrm{g}$ nước ở nhiệt độ $17^\circ\mathrm{C}$. Khi đó nhiệt độ của nước tăng lên đến $23^\circ\mathrm{C}$, biết nhiệt dung riêng của sắt là $460\,\mathrm{J/(kg.K)}$, của nước là $4200\,\mathrm{J/(kg.K)}$. Nhiệt độ của lò xấp xỉ bằng bao nhiêu K?
\shortans{1282}
\loigiai{
Bỏ qua nhiệt lượng kế và hao phí. Nhiệt lượng nước nhận bằng nhiệt lượng miếng sắt tỏa ra:
\[
m_{\mathrm{n}}c_{\mathrm{n}}(23-17)
=m_{\mathrm{s}}c_{\mathrm{s}}(T-23).
\]
Thay số:
\[
0{,}9\cdot4200\cdot6
=0{,}05\cdot460(T-23).
\]
Suy ra
\[
T-23=\frac{22680}{23}\approx986{,}1^\circ\mathrm{C},
\]
\[
T\approx1009{,}1^\circ\mathrm{C}.
\]
Đổi sang Kelvin:
\[
T\approx1009{,}1+273{,}15\approx1282\,\mathrm{K}.
\]
}
\end{ex}

\begin{ex}
Tính nhiệt lượng cần thiết theo đơn vị kJ để đun $5\,\mathrm{kg}$ nước từ $15^\circ\mathrm{C}$ đến $100^\circ\mathrm{C}$ trong một cái thùng bằng sắt có khối lượng $1{,}5\,\mathrm{kg}$. Biết nhiệt dung riêng của nước là $4200\,\mathrm{J/(kg.K)}$, của sắt là $460\,\mathrm{J/(kg.K)}$.
\shortans{1843,65}
\loigiai{
Độ tăng nhiệt độ:
\[
\Delta T=100-15=85^\circ\mathrm{C}.
\]
Nhiệt lượng cần cung cấp cho nước:
\[
Q_1=m_1c_1\Delta T
=5\cdot4200\cdot85
=1\,785\,000\,\mathrm{J}.
\]
Nhiệt lượng cần cung cấp cho thùng sắt:
\[
Q_2=m_2c_2\Delta T
=1{,}5\cdot460\cdot85
=58\,650\,\mathrm{J}.
\]
Tổng nhiệt lượng:
\[
Q=Q_1+Q_2
=1\,843\,650\,\mathrm{J}
=1843{,}65\,\mathrm{kJ}.
\]
}
\end{ex}


