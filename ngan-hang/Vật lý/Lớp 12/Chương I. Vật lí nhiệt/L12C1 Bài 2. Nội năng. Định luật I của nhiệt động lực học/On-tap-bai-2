{Nội năng của chất khí bị mất đi.}
\loigiai{Nước nóng truyền nhiệt cho không khí bên trong bóng, làm nội năng của khí tăng, khí nở ra và đẩy phần móp của bóng phồng trở lại.}
\end{ex}

\begin{ex}
